# Database (docker compose maps PostgreSQL to localhost:5437)
IPOS_DB_HOST=localhost
IPOS_DB_PORT=5437
IPOS_DB_NAME=ipos
IPOS_DB_USER=postgres
IPOS_DB_PASSWORD=postgres
IPOS_DB_URL=jdbc:postgresql://localhost:5437/ipos

# First-run administrator (created only when the user table is empty)
IPOS_ADMIN_USERNAME=admin
IPOS_ADMIN_PASSWORD=replace-with-a-strong-password
IPOS_ADMIN_FULL_NAME=Administrator
IPOS_ADMIN_EMAIL=admin@example.com

# Application
IPOS_PROFILE=dev
IPOS_SERVER_PORT=8081
IPOS_ZONE=Africa/Kigali
IPOS_UPLOAD_DIR=./data/uploads
IPOS_ENCRYPTION_KEY=replace-with-a-long-random-secret
IPOS_REMEMBER_ME_KEY=replace-with-a-long-random-token
IPOS_SYNC_TOKEN=replace-with-a-long-random-token
IPOS_DEMO_DATA=false

# SMTP (Mailpit in development)
IPOS_SMTP_HOST=localhost
IPOS_SMTP_PORT=1025
